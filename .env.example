# Sao chép file này thành .env.local rồi điền giá trị (.env.local đã bị .gitignore chặn).
# Các biến VITE_* được nhúng vào bundle phía trình duyệt — chỉ đặt config PUBLIC, không đặt secret.

# Bước 2 chỉ dùng dữ liệu MOCK nên CHƯA đọc các biến dưới đây.
# Firebase Web App config — điền khi nhóm trưởng đăng ký Web App (bước sau).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
