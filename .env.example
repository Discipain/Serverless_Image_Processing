# Sao chép file này thành .env.local rồi điền giá trị (.env.local đã bị .gitignore chặn).
# Các biến VITE_* được nhúng vào bundle phía trình duyệt — chỉ đặt config PUBLIC, không đặt secret
# (không đặt service-account JSON, token, Cloudinary secret... vào đây).

# Firebase Web App config — lấy trong Firebase Console:
#   Project settings -> General -> Your apps -> "image-processing-web" -> SDK setup and configuration.
# Project: image-processing-project-ea23d
#
# Quy tắc chọn chế độ (src/app/createAuthServices.js):
#   - KHÔNG điền biến nào (hoặc không có .env.local) -> chế độ MOCK (đăng nhập giả lập, không có ID token thật).
#   - Điền đủ 3 biến BẮT BUỘC (API_KEY, AUTH_DOMAIN, PROJECT_ID) -> Firebase Authentication thật.
#   - Điền một phần nhưng thiếu biến bắt buộc, hoặc khởi tạo lỗi -> báo LỖI CẤU HÌNH (KHÔNG tự chuyển sang MOCK).
# STORAGE_BUCKET, MESSAGING_SENDER_ID, APP_ID là TÙY CHỌN: đăng nhập Google không cần Storage bucket.
# Sau khi sửa .env.local phải dừng và chạy lại "npm run dev".
# BẮT BUỘC:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# TÙY CHỌN (điền nếu có trong cấu hình Web App của Firebase Console):
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (H2) — UNSIGNED upload trực tiếp từ trình duyệt (phương án nhóm đã chốt). Cả hai giá trị là PUBLIC.
# Lấy từ Hưng (xem CLOUDINARY.md trên nhánh dev). TUYỆT ĐỐI KHÔNG đặt API key/secret ở đây.
# Thiếu một trong hai -> upload báo lỗi cấu hình rõ ràng (ứng dụng vẫn chạy bình thường).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Backend FastAPI (H3A) — gọi POST /images/cloudinary/confirm với Authorization: Bearer <Firebase ID token>.
#   VITE_BACKEND_MODE=mock (hoặc để trống) -> Backend GIẢ (MOCK), KHÔNG có request nào ra Backend thật. MẶC ĐỊNH.
#   VITE_BACKEND_MODE=real                 -> Backend thật; BẮT BUỘC có VITE_API_BASE_URL hợp lệ.
#   Chọn real mà thiếu/sai URL -> báo lỗi cấu hình, KHÔNG tự chuyển sang MOCK.
# VITE_API_BASE_URL: https://host (http chỉ cho phép với localhost, vd http://localhost:8000), không query, không "user:pass@".
# Hiện Backend chưa có API confirm đúng CONTRACT nên H3A chỉ dùng mock; đừng đặt real khi chưa được nhóm xác nhận.
VITE_BACKEND_MODE=mock
VITE_API_BASE_URL=

# Gallery (INT-3B) — nguồn dữ liệu trang Thư viện ảnh. MẶC ĐỊNH MOCK; có .env.local đầy đủ cũng KHÔNG tự bật REAL.
#   VITE_GALLERY_MODE=mock (hoặc để trống) -> Gallery MOCK, không request ra Backend.
#   VITE_GALLERY_MODE=real                 -> Gallery REAL, CHỈ khi đồng thời: VITE_BACKEND_MODE=real, VITE_API_BASE_URL là Backend
#       localhost (localhost/127.0.0.1/[::1]), chạy "npm run dev" (không phải bản build) và Firebase Authentication thật (VITE_FIREBASE_*).
#   Thiếu một điều kiện -> trang hiện LỖI CẤU HÌNH, KHÔNG tự chuyển sang MOCK. Chưa dùng Backend từ xa ở giai đoạn này.
VITE_GALLERY_MODE=mock
