  rules_version = '2';
  service firebase.storage {
    match /b/{bucket}/o {
      function isOwner(uid) {
        return request.auth != null && request.auth.uid == uid;
      }

      function isValidImage() {
        return request.resource.size <= 10 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp)');
      }

      // Thư mục ảnh gốc người dùng tải lên
      match /uploads/{uid}/{allPaths=**} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && isValidImage();
      }

      // Thư mục ảnh đã qua xử lý (variants)
      match /processed/{uid}/{allPaths=**} {
        allow read: if isOwner(uid);
        allow write: if false; // Chỉ hệ thống được ghi
      }
    }
  }